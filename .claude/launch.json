{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "HisabFlow Frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "--port", "3000"],
      "cwd": "apps/web",
      "port": 3000
    },
    {
      "name": "HisabFlow Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
