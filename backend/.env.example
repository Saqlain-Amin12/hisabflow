# Copy to .env and fill in values

# PostgreSQL connection string (Render provides this automatically via render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/hisabflow

# Environment
ENVIRONMENT=production
DEBUG=false

# Frontend URL(s) — comma-separated, no trailing slash
ALLOWED_ORIGINS=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# Gmail SMTP (use an App Password, not your real password)
# Enable 2FA on your Gmail → Google Account → Security → App passwords
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
